name: radar
on:
  schedule:
    - cron: "*/5 * * * *"
  workflow_dispatch:
permissions:
  contents: write
concurrency:
  group: radar
  cancel-in-progress: false
jobs:
  run:
    runs-on: ubuntu-latest
    timeout-minutes: 4
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Lancer le radar
        env:
          DISCORD_WEBHOOK: ${{ secrets.DISCORD_WEBHOOK }}
        run: python radar.py
      - name: Sauvegarder l'historique
        run: |
          git config user.name "radar"
          git config user.email "radar@users.noreply.github.com"
          git add data
          git diff --cached --quiet || (git commit -m "maj" && git pull --rebase && git push)
